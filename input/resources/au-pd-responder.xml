    <!-- ORGANIZATION :: DONE -->
    <resource>
      <extension url="http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation">
        <valueCode value="SHOULD"/>
      </extension>
      <type value="Organization"/>
      <profile value="http://hl7.org.au/fhir/pd/StructureDefinition/au-pd-organisation"/>
      <documentation
        value="If the responder supports the Organization resource, the responder **SHALL** support the AU PD profile and the conformance expectations for the Organization resource."/>
      <interaction>
        <extension url="http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation">
          <valueCode value="SHALL"/>
